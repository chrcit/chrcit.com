# Copy to .env for local development

# ------------------------------
# Sanity (public, safe in client)
# ------------------------------
VITE_SANITY_PROJECT_ID=pqdr91mr
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-02-13
# Embedded Studio URL (used for visual editing)
VITE_SANITY_STUDIO_URL=http://localhost:5173/studio

# ------------------------------
# Sanity (private, server-only)
# ------------------------------
# Preferred token name
SANITY_API_READ_TOKEN=
# Back-compat token name (optional)
SANITY_READ_TOKEN=

# Cookie session secret for preview mode
SANITY_SESSION_SECRET=please-change-me

# Optional shared secret for a future cache revalidation webhook adapter.
# Workers Cache is enabled by Wrangler; this starter does not fake tag purging.
CACHE_PURGE_SECRET=

# Presentation preview origin (production domain)
VITE_SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:5173
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:5173

# ------------------------------
# Site
# ------------------------------
# Canonical site URL (used by sitemap/robots)
SITE_URL=http://localhost:5173
# Optional platform-provided URL fallback
PRODUCTION_URL=

# MailerLite custom newsletter endpoint (private, server-only)
MAILERLITE_API_TOKEN=

# Cloudflare Worker deployment
# ----------------------------
# Public vars are code-defined in wrangler.jsonc. Keep only secrets here and
# copy them to .dev.vars locally or to Cloudflare Variables & Secrets.
# See .dev.vars.example for the complete Worker secret template.

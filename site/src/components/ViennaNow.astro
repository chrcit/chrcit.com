---
// Clock is local (Europe/Vienna). Weather is fetched in the browser from Open-Meteo.
---

<span class="vienna-now" data-vienna-now>
  <time data-vienna-time datetime="">&nbsp;</time>
  <span class="wx" data-vienna-wx hidden>
    <span class="wx-icon" data-vienna-icon aria-hidden="true"></span>
    <span class="wx-temp" data-vienna-temp></span>
  </span>
</span>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-vienna-now]");
    if (!root) return;

    const timeEl = root.querySelector("[data-vienna-time]");
    const wxEl = root.querySelector("[data-vienna-wx]");
    const iconEl = root.querySelector("[data-vienna-icon]");
    const tempEl = root.querySelector("[data-vienna-temp]");

    const tz = "Europe/Vienna";
    const timeFmt = new Intl.DateTimeFormat("en-GB", {
      timeZone: tz,
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });

    const tick = () => {
      const now = new Date();
      const label = timeFmt.format(now);
      if (timeEl) {
        timeEl.dateTime = now.toISOString();
        timeEl.textContent = label;
      }
    };
    tick();
    setInterval(tick, 1000 * 15);

    const ICONS = {
      clear:
        '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"><circle cx="8" cy="8" r="2.6" fill="currentColor" stroke="none"/><path d="M8 1.6v1.8M8 12.6v1.8M1.6 8h1.8M12.6 8h1.8M3.3 3.3l1.3 1.3M11.4 11.4l1.3 1.3M3.3 12.7l1.3-1.3M11.4 4.6l1.3-1.3"/></svg>',
      cloud:
        '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter"><path d="M4.2 11.4h7.4a2.2 2.2 0 0 0 .2-4.4 3.2 3.2 0 0 0-6.1-1.1A2.4 2.4 0 0 0 4.2 11.4z"/></svg>',
      overcast:
        '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3.4 11.6h8.4a2.1 2.1 0 0 0 .1-4.2 3 3 0 0 0-5.8-1A2.3 2.3 0 0 0 3.4 11.6z"/><path d="M4.6 12.8h7.2"/></svg>',
      fog: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"><path d="M2.5 5.5h11M3.5 8h9M2.5 10.5h11"/></svg>',
      rain: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"><path d="M4.4 8.6h7.2A2 2 0 0 0 11.8 4.6 3 3 0 0 0 6 3.8 2.2 2.2 0 0 0 4.4 8.6z"/><path d="M6 10.4l-.8 2.4M8.4 10.4l-.8 2.4M10.8 10.4l-.8 2.4"/></svg>',
      snow: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"><path d="M8 2.4v11.2M3.4 8h9.2M4.6 4.6l6.8 6.8M11.4 4.6l-6.8 6.8"/></svg>',
      storm:
        '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter"><path d="M4.4 8.2h6.8A2 2 0 0 0 11.4 4.2 3 3 0 0 0 5.8 3.4 2.2 2.2 0 0 0 4.4 8.2z"/><path d="M8.6 8.4L6.6 12h2.2l-1.6 3"/></svg>',
    };

    const iconFor = (code) => {
      if (code === 0 || code === 1) return ICONS.clear;
      if (code === 2) return ICONS.cloud;
      if (code === 3) return ICONS.overcast;
      if (code === 45 || code === 48) return ICONS.fog;
      if (code >= 71 && code <= 77) return ICONS.snow;
      if (code === 85 || code === 86) return ICONS.snow;
      if (code >= 95) return ICONS.storm;
      return ICONS.rain;
    };

    const applyWx = (temp, code) => {
      if (!wxEl || !iconEl || !tempEl) return;
      const rounded = Math.round(temp);
      iconEl.innerHTML = iconFor(code);
      tempEl.textContent = `${rounded}°`;
      wxEl.hidden = false;
      wxEl.setAttribute("title", `Vienna ${rounded}°C`);
    };

    const KEY = "chrcit-vienna-wx";
    const TTL = 20 * 60 * 1000;
    try {
      const cached = JSON.parse(sessionStorage.getItem(KEY) || "null");
      if (cached && Date.now() - cached.at < TTL) applyWx(cached.temp, cached.code);
    } catch (_) {}

    const url =
      "https://api.open-meteo.com/v1/forecast?latitude=48.2082&longitude=16.3738&current=temperature_2m,weather_code&timezone=Europe%2FVienna";
    fetch(url, { referrerPolicy: "no-referrer" })
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((data) => {
        const temp = data && data.current && data.current.temperature_2m;
        const code = data && data.current && data.current.weather_code;
        if (typeof temp !== "number" || typeof code !== "number") return;
        applyWx(temp, code);
        try {
          sessionStorage.setItem(KEY, JSON.stringify({ at: Date.now(), temp, code }));
        } catch (_) {}
      })
      .catch(() => {});
  })();
</script>

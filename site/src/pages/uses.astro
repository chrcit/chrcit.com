---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ItemRow from "../components/ItemRow.astro";

const tools = (await getCollection("items")).filter((i) => i.data.category === "tool");

const groupOrder = [
  { key: "Gear", label: "Gear" },
  { key: "Stack", label: "Tech Stack" },
  { key: "Dev Tools", label: "Dev Tools" },
  { key: "Productivity", label: "Productivity" },
];

const groupedKeys = new Set(groupOrder.map((g) => g.key));
const groups = [
  ...groupOrder.map(({ key, label }) => ({
    name: label,
    items: tools
      .filter((t) => t.data.group === key)
      .sort((a, b) => a.data.title.localeCompare(b.data.title)),
  })),
  ...[...new Set(tools.map((t) => t.data.group).filter((g): g is string => !!g && !groupedKeys.has(g)))]
    .sort()
    .map((name) => ({
      name,
      items: tools
        .filter((t) => t.data.group === name)
        .sort((a, b) => a.data.title.localeCompare(b.data.title)),
    })),
].filter((g) => g.items.length > 0);
---

<Base title="Uses — chrcit.com" description="Gear, stack, and software I use.">
  <main class="page">
    <section class="tile">
      <div class="tile-label"><span>Uses</span><span class="num">{tools.length} items</span></div>
      <h1 class="page-title">Uses</h1>
      <p class="page-note">
        The gear, the stack, and the software. Grouped the way I actually think about them.
        Updated when something earns its place or loses it.
      </p>
    </section>

    {
      groups.map((group) => (
        <section class="tile">
          <h2 class="group-title" id={group.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}>
            {group.name}
          </h2>
          <ul class="items items-split">
            {group.items.map((item) => (
              <li>
                <ItemRow item={item} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Base>

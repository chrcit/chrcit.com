---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Roles from "../components/Roles.tsx";
import SampleList, { type SampleItem } from "../components/SampleList.tsx";

const items = await getCollection("items");

const sample = <T,>(arr: T[], n: number) =>
  [...arr].sort(() => Math.random() - 0.5).slice(0, n);

const groupLabel: Record<string, string> = {
  Gear: "Gear",
  Stack: "Tech Stack",
  "Dev Tools": "Dev Tools",
  Productivity: "Productivity",
};

const booksAll: SampleItem[] = await Promise.all(
  items
    .filter((i) => i.data.category === "book")
    .map(async (i) => {
      const img = i.data.cover
        ? await getImage({ src: i.data.cover, width: 160, height: 240 })
        : null;
      return {
        id: i.id,
        title: i.data.title,
        meta: [i.data.author, i.data.year].filter(Boolean).join(", "),
        rating: i.data.rating ?? null,
        url: i.data.url ?? null,
        image: img?.src ?? null,
        kind: "book" as const,
      };
    }),
);

const toolsAll: SampleItem[] = await Promise.all(
  items
    .filter((i) => i.data.category === "tool" && i.data.url)
    .map(async (i) => {
      const img = i.data.icon
        ? await getImage({ src: i.data.icon, width: 160, height: 160 })
        : null;
      return {
        id: i.id,
        title: i.data.title,
        meta: i.data.group ? (groupLabel[i.data.group] ?? i.data.group) : undefined,
        rating: null,
        url: i.data.url ?? null,
        image: img?.src ?? null,
        kind: "tool" as const,
      };
    }),
);

const bookSample = sample(booksAll, 3);
const toolSample = sample(toolsAll, 3);

const photos = [
  { role: "default", src: "/images/portrait-dither.png", alt: "Christian Cito" },
  { role: "arthouse", src: "/images/roles/arthouse.png", alt: "" },
  { role: "hausgemacht", src: "/images/roles/hausgemacht.png", alt: "" },
  { role: "rebased", src: "/images/roles/rebased.png", alt: "" },
  { role: "writer", src: "/images/roles/writer.png", alt: "" },
];
---

<Base>
  <main class="mosaic">
    <section class="tile tile-photo col-photo" id="role-photo">
      {
        photos.map((p, i) => (
          <img
            src={p.src}
            alt={p.alt}
            width="720"
            height="1080"
            data-role={p.role}
            class={i === 0 ? "is-active" : undefined}
            aria-hidden={i === 0 ? "false" : "true"}
          />
        ))
      }
      <span class="photo-spot" aria-hidden="true"></span>
    </section>

    <section class="tile col-lead tile-lead" id="do">
      <h1 class="lead-copy">
        Hi, I'm Christian Cito. I write code, create products, run teams, organise
        communities and sometimes do some writing.
      </h1>
      <Roles client:load />
    </section>

    <section class="tile span-2" id="books">
      <SampleList
        client:load
        label="Favorite Books"
        items={booksAll}
        initial={bookSample}
        moreHref="/books"
        moreLabel="All books →"
      />
    </section>

    <section class="tile span-2" id="tools">
      <SampleList
        client:load
        label="Favorite Tools"
        items={toolsAll}
        initial={toolSample}
        moreHref="/uses"
        moreLabel="All tools →"
      />
    </section>
  </main>
</Base>

<script>
  const photo = document.getElementById("role-photo");
  if (photo) {
    const move = (e: PointerEvent) => {
      const r = photo.getBoundingClientRect();
      photo.style.setProperty("--mx", `${e.clientX - r.left}px`);
      photo.style.setProperty("--my", `${e.clientY - r.top}px`);
    };
    photo.addEventListener("pointermove", move);
    photo.addEventListener("pointerenter", move);
  }
</script>

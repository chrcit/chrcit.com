---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ItemCard from "../components/ItemCard.astro";

const books = (await getCollection("items"))
  .filter((i) => i.data.category === "book")
  .sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0) || a.data.title.localeCompare(b.data.title));
---

<Base title="Books — chrcit.com" description="Books I've read, rated out of 10.">
  <main class="page">
    <section class="tile">
      <div class="tile-label"><span>Books</span><span class="num">{books.length} rated</span></div>
      <h1 class="page-title">Books</h1>
      <p class="page-note">
        Everything I've rated, best first. The rating is the review.
      </p>
    </section>

    <section class="tile">
      <ul class="items">
        {
          books.map((item) => (
            <li>
              <ItemCard item={item} />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>

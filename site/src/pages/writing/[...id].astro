---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Tweet from "../../components/embeds/Tweet.astro";
import YouTube from "../../components/embeds/YouTube.astro";
import Instagram from "../../components/embeds/Instagram.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const date = post.data.publishedAt.toISOString().slice(0, 10);
const kind = post.data.kind === "annual" ? "Year in review" : "Notes";
---

<Base title={`${post.data.title} — chrcit.com`} description={post.data.description}>
  <main class="page">
    <article class="tile article">
      <div class="tile-label">
        <span>{kind}</span>
        <span class="num">{date}</span>
      </div>
      <h1 class="page-title">{post.data.title}</h1>
      {
        post.data.image && (
          <div class="article-hero">
            <Image src={post.data.image} alt="" width={1280} height={720} />
          </div>
        )
      }
      <div class="article-body">
        <div class="prose">
          <Content components={{ Tweet, YouTube, Instagram }} />
        </div>
        <TableOfContents headings={headings} />
      </div>
    </article>
  </main>
</Base>

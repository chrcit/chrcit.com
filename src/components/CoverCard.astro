---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { ditherFor } from "../utils/dither";

interface Props {
  item: CollectionEntry<"items">;
}

const { item } = Astro.props;
const { title, author, rating, cover } = item.data;
const slug = item.id.replace(/^books\//, "");
const href = `/books/${slug}`;
---

<a class="cover-card" href={href}>
  <span class={`cover-frame ${ditherFor(title)}`}>
    {
      cover ? (
        <Image src={cover} alt={title} width={400} height={600} fit="cover" loading="lazy" />
      ) : (
        <span class="cover-fallback">{title.charAt(0)}</span>
      )
    }
    {rating != null && <span class="cover-score">{rating}/10</span>}
  </span>
  <span class="cover-copy">
    <span class="cover-title">{title}</span>
    {author && <span class="cover-meta">{author}</span>}
  </span>
</a>

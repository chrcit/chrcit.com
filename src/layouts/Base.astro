---
import "../styles/global.css";
import Elsewhere from "../components/Elsewhere.astro";
import ViennaNow from "../components/ViennaNow.astro";
import { socials } from "../data/socials";

interface Props {
  title?: string;
  description?: string;
  /** Set to null for error or utility pages that should not expose a canonical URL. */
  canonical?: string | URL | null;
  /** Prevent a page from appearing in search results. */
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Primary social image. The landscape site image is used when omitted. */
  ogImage?: string | URL;
  /** Optional secondary image for clients that prefer a square preview. */
  ogImageSquare?: string | URL | null;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  articlePublishedTime?: Date | string;
  articleModifiedTime?: Date | string;
  articleAuthor?: string;
}

const {
  title = "Christian Cito | chrcit.com",
  description = "Christian Cito. Product engineer, director at Arthouse, Vienna.",
  canonical: canonicalProp,
  noindex = false,
  ogType = "website",
  ogImage = "/og-image.png",
  ogImageSquare = "/og-image-square.png",
  ogImageAlt = "Dithered print of a clear sunny sky with a red sun. chrcit.com",
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageType = "image/png",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor = "https://chrcit.com/",
} = Astro.props;

const year = new Date().getFullYear();
const site = Astro.site ?? new URL("https://chrcit.com");
const canonical = canonicalProp === null ? null : new URL(canonicalProp ?? Astro.url.pathname, site);
const socialImage = new URL(ogImage, site);
const socialImageSquare = ogImageSquare ? new URL(ogImageSquare, site) : null;
const toIsoString = (value?: Date | string) =>
  value instanceof Date ? value.toISOString() : value;
const structuredData =
  Astro.url.pathname === "/"
    ? {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": new URL("/#person", site).href,
            name: "Christian Cito",
            url: site.href,
            jobTitle: "Product engineer",
            homeLocation: {
              "@type": "Place",
              name: "Vienna, Austria",
            },
            sameAs: socials.map((social) => social.url),
          },
          {
            "@type": "WebSite",
            "@id": new URL("/#website", site).href,
            url: site.href,
            name: "chrcit.com",
            description,
            inLanguage: "en",
            publisher: { "@id": new URL("/#person", site).href },
          },
        ],
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f3f0e7" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="author" content="Christian Cito" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {canonical && <link rel="canonical" href={canonical.href} />}
    <link
      rel="preload"
      href="/fonts/apfel-grotezk/ApfelGrotezk-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/apfel-grotezk/ApfelGrotezk-Fett.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="chrcit.com" />
    <meta property="og:locale" content="en_AT" />
    {canonical && <meta property="og:url" content={canonical.href} />}
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {socialImageSquare && <meta property="og:image" content={socialImageSquare.href} />}
    {socialImageSquare && <meta property="og:image:width" content="1200" />}
    {socialImageSquare && <meta property="og:image:height" content="1200" />}
    {socialImageSquare && <meta property="og:image:type" content="image/png" />}
    {socialImageSquare && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@chrcit" />
    <meta name="twitter:creator" content="@chrcit" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {
      ogType === "article" && articlePublishedTime && (
        <meta property="article:published_time" content={toIsoString(articlePublishedTime)} />
      )
    }
    {
      ogType === "article" && articleModifiedTime && (
        <meta property="article:modified_time" content={toIsoString(articleModifiedTime)} />
      )
    }
    {ogType === "article" && <meta property="article:author" content={articleAuthor} />}
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        ></script>
      )
    }
  </head>
  <body>
    <div class="wrap">
      <div class="topbar">
        <a href="/">chrcit.com</a>
        <span class="locale">
          <span>Vienna, AT</span>
          <ViennaNow />
        </span>
      </div>

      <slot />

      <footer>
        <Elsewhere />
        <div class="footer-bar">
          <span>© {year} Christian Cito</span>
          <nav class="legal">
            <a href="/colophon">Colophon</a>
            <a href="/imprint">Imprint</a>
            <a href="/privacy">Privacy</a>
          </nav>
        </div>
      </footer>
    </div>
    <script is:inline defer data-domain="chrcit.com" src="https://plausible.io/js/script.js"></script>
  </body>
</html>

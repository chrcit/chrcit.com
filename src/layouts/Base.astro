---
import "@fontsource-variable/inter-tight";
import "../styles/global.css";
import Elsewhere from "../components/Elsewhere.astro";
import ViennaNow from "../components/ViennaNow.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Christian Cito | chrcit.com",
  description = "Christian Cito. Product engineer, director at Arthouse, Vienna.",
} = Astro.props;

const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://chrcit.com");
const ogImage = new URL("/og-image.png", Astro.site ?? "https://chrcit.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
  </head>
  <body>
    <div class="wrap">
      <div class="topbar">
        <a href="/">chrcit.com</a>
        <span class="locale">
          <span>Vienna, AT</span>
          <ViennaNow />
        </span>
      </div>

      <slot />

      <footer>
        <Elsewhere />
        <div class="footer-bar">
          <span>© {year} Christian Cito</span>
          <nav class="legal">
            <a href="/colophon">Colophon</a>
            <a href="/imprint">Imprint</a>
            <a href="/privacy">Privacy</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>

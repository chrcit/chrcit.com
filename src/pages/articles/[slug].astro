---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import Tweet from "../../components/embeds/Tweet.astro";
import YouTube from "../../components/embeds/YouTube.astro";
import Instagram from "../../components/embeds/Instagram.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const date = post.data.publishedAt.toISOString().slice(0, 10);
const kindLabel = post.data.kind === "annual" ? "Year in review" : "Notes";
const socialImageType = post.data.image
  ? `image/${post.data.image.format === "jpg" ? "jpeg" : post.data.image.format}`
  : undefined;
---

<Base
  title={`${post.data.title} | chrcit.com`}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.image?.src}
  ogImageAlt={post.data.image ? `Illustration for ${post.data.title}` : undefined}
  ogImageWidth={post.data.image?.width}
  ogImageHeight={post.data.image?.height}
  ogImageType={socialImageType}
  articlePublishedTime={post.data.publishedAt}
  articleAuthor="https://chrcit.com/"
>
  <main class="page">
    <article class="tile article">
      <div class="tile-label">
        <span>{kindLabel}</span>
        <time class="num" datetime={date}>{date}</time>
      </div>
      <h1 class="page-title">{post.data.title}</h1>
      {
        post.data.image && (
          <div class="article-hero">
            <Image
              src={post.data.image}
              alt={`Illustration for ${post.data.title}`}
              width={1280}
              height={720}
            />
          </div>
        )
      }
      <div class="article-body">
        <div class="prose">
          <Content components={{ Tweet, YouTube, Instagram }} />
        </div>
        <TableOfContents headings={headings} />
      </div>
    </article>
  </main>
</Base>

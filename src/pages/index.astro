---
export const prerender = false;

import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import Roles from "../components/Roles.tsx";
import SampleList, { type SampleItem } from "../components/SampleList.tsx";
import WeatherDither from "../components/WeatherDither.astro";
import { loadHomeItems } from "../utils/home-items";
import {
  BOOK_SAMPLE_SIZE,
  HOME_CACHE_CONTROL,
  TOOL_SAMPLE_SIZE,
  pickItems,
} from "../utils/home-sample";

const readCatalog = async (): Promise<{ books: SampleItem[]; tools: SampleItem[] }> => {
  const url = new URL("/home-items.json", Astro.url);
  const res = env.ASSETS ? await env.ASSETS.fetch(url) : await fetch(url);
  if (!res.ok) throw new Error(`home catalog ${res.status}`);
  return res.json();
};

let booksAll: SampleItem[];
let toolsAll: SampleItem[];
try {
  const catalog = await readCatalog();
  booksAll = catalog.books;
  toolsAll = catalog.tools;
} catch {
  ({ books: booksAll, tools: toolsAll } = await loadHomeItems(false));
}

const bookSample = pickItems(booksAll, BOOK_SAMPLE_SIZE);
const toolSample = pickItems(toolsAll, TOOL_SAMPLE_SIZE);

Astro.response.headers.set("Cache-Control", HOME_CACHE_CONTROL);
---

<Base>
  <main class="mosaic">
    <section class="tile tile-photo col-photo">
      <img src="/images/portrait-dither.png" alt="Christian Cito" width="780" height="1296" />
    </section>

    <section class="tile col-lead tile-lead" id="do">
      <h1 class="lead-copy">
        Hi, I'm <strong>Christian Cito</strong>. I write code, create products, run teams,
        organise communities, and sometimes do some writing.
      </h1>
      <Roles client:load />
    </section>

    <section class="tile span-2" id="books">
      <SampleList
        client:load
        label="Favorite Books"
        items={booksAll}
        initial={bookSample}
        mobileCount={3}
        moreHref="/books"
        moreLabel="All books →"
      />
    </section>

    <section class="tile span-2" id="tools">
      <SampleList
        client:load
        label="Favorite Tools"
        items={toolsAll}
        initial={toolSample}
        mobileCount={4}
        moreHref="/uses"
        moreLabel="All tools →"
      />
    </section>

    <WeatherDither />
  </main>
</Base>

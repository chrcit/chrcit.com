---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Roles from "../components/Roles.tsx";
import SampleList, { type SampleItem } from "../components/SampleList.tsx";
import WeatherDither from "../components/WeatherDither.astro";

const items = await getCollection("items");

const sample = <T,>(arr: T[], n: number) =>
  [...arr].sort(() => Math.random() - 0.5).slice(0, n);

const groupLabel: Record<string, string> = {
  Gear: "Gear",
  Stack: "Tech Stack",
  "Dev Tools": "Dev Tools",
  Productivity: "Productivity",
};

const booksAll: SampleItem[] = await Promise.all(
  items
    .filter((i) => i.data.category === "book")
    .map(async (i) => {
      const img = i.data.cover
        ? await getImage({ src: i.data.cover, width: 240, height: 360 })
        : null;
      return {
        id: i.id,
        title: i.data.title,
        meta: [i.data.author, i.data.year].filter(Boolean).join(", "),
        url: `/${i.id}`,
        image: img?.src ?? null,
        kind: "book" as const,
      };
    }),
);

const toolsAll: SampleItem[] = await Promise.all(
  items
    .filter((i) => i.data.category === "tool" && i.data.url)
    .map(async (i) => {
      const img = i.data.icon
        ? await getImage({ src: i.data.icon, width: 160, height: 160 })
        : null;
      return {
        id: i.id,
        title: i.data.title,
        meta: i.data.group ? (groupLabel[i.data.group] ?? i.data.group) : undefined,
        url: i.data.url ?? null,
        image: img?.src ?? null,
        kind: "tool" as const,
      };
    }),
);

const bookSample = sample(booksAll, 6);
const toolSample = sample(toolsAll, 8);
---

<Base>
  <main class="mosaic">
    <section class="tile tile-photo col-photo">
      <img src="/images/portrait-dither.png" alt="Christian Cito" width="780" height="1296" />
    </section>

    <section class="tile col-lead tile-lead" id="do">
      <h1 class="lead-copy">
        Hi, I'm <strong>Christian Cito</strong>. I write code, create products, run teams,
        organise communities, and sometimes do some writing.
      </h1>
      <Roles client:load />
    </section>

    <section class="tile span-2" id="books">
      <SampleList
        client:load
        label="Favorite Books"
        items={booksAll}
        initial={bookSample}
        moreHref="/books"
        moreLabel="All books →"
      />
    </section>

    <section class="tile span-2" id="tools">
      <SampleList
        client:load
        label="Favorite Tools"
        items={toolsAll}
        initial={toolSample}
        moreHref="/uses"
        moreLabel="All tools →"
      />
    </section>

    <WeatherDither />
  </main>
</Base>

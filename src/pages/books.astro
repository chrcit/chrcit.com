---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import CoverCard from "../components/CoverCard.astro";

const books = await getCollection("items").then((items) =>
  items.filter((i) => i.data.category === "book"),
);

const genreOrder = [
  "Politics, History, and Economics",
  "Self-Development",
  "Meditation",
  "Entertainment",
  "Fiction",
];

const groups = genreOrder
  .map((name) => ({
    name,
    items: books
      .filter((b) => b.data.genre === name)
      .sort(
        (a, b) =>
          (b.data.rating ?? 0) - (a.data.rating ?? 0) || a.data.title.localeCompare(b.data.title),
      ),
  }))
  .filter((g) => g.items.length > 0);
---

<Base title="Some of my favourite books | chrcit.com" description="Some of my favourite books.">
  <main class="page">
    <section class="tile">
      <h1 class="page-title">Some of my favourite books</h1>
    </section>

    {
      groups.map((group) => (
        <section class="topic-block" id={group.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}>
          <h2 class="group-title">{group.name}</h2>
          <div class="tile">
            <div class="cover-grid">
              {group.items.map((item) => (
                <CoverCard item={item} />
              ))}
            </div>
          </div>
        </section>
      ))
    }

    <section class="tile">
      <blockquote class="page-quote">
        <p>
          Of all the things written, I love only what a person has written with his own blood.
          Write with blood, and you will experience that blood is spirit.
        </p>
        <footer>Friedrich Nietzsche, <cite>The Gay Science</cite></footer>
      </blockquote>
    </section>
  </main>
</Base>

---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ItemRow from "../components/ItemRow.astro";

const tools = (await getCollection("items")).filter((i) => i.data.category === "tool");

const groupOrder = [
  { key: "Stack", label: "Tech Stack" },
  { key: "Dev Tools", label: "Dev Tools" },
  { key: "Productivity", label: "Productivity" },
  { key: "Gear", label: "Gear" },
];

const groupedKeys = new Set(groupOrder.map((g) => g.key));
const sectionId = (name: string) =>
  name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "section";
const groups = [
  ...groupOrder.map(({ key, label }) => ({
    name: label,
    items: tools
      .filter((t) => t.data.group === key)
      .sort((a, b) => (a.data.rank ?? 99) - (b.data.rank ?? 99) || a.data.title.localeCompare(b.data.title)),
  })),
  ...[...new Set(tools.map((t) => t.data.group).filter((g): g is string => !!g && !groupedKeys.has(g)))]
    .sort()
    .map((name) => ({
      name,
      items: tools
        .filter((t) => t.data.group === name)
        .sort((a, b) => (a.data.rank ?? 99) - (b.data.rank ?? 99) || a.data.title.localeCompare(b.data.title)),
    })),
].filter((g) => g.items.length > 0);
---

<Base title="Things I like to use | chrcit.com" description="Things I like to use.">
  <main class="page">
    <section class="tile">
      <h1 class="page-title">Things I like to use</h1>
    </section>

    {
      groups.map((group) => (
        <section
          class="topic-block"
          id={sectionId(group.name)}
          aria-labelledby={`${sectionId(group.name)}-title`}
        >
          <h2 class="group-title" id={`${sectionId(group.name)}-title`}>
            {group.name}
          </h2>
          <div class="tile">
            <ul class="items items-split">
              {group.items.map((item) => (
                <li>
                  <ItemRow item={item} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </main>
</Base>
